# Files here are NOT uploaded as public static assets.
#
# The assets directory is the repo root, and unlike Pages, Workers does not
# auto-exclude anything. Without this file the entire .git directory would be
# published as browsable public files.

**/.git
**/node_modules
**/.DS_Store
**/Thumbs.db

# Config and tooling, not site content
wrangler.jsonc
.assetsignore
.gitignore
.claude

